// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


datasource db {
  provider = "postgresql"
}



generator client {
  provider = "prisma-client-js"
   output   = "../src/generated/prisma"
}

enum UserRole {
  ADMIN
  OPERATOR
  USER
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum SportType {
  FOOTBALL
  CRICKET
}

enum PredictionOutcome {
  HOME_WIN
  DRAW
  AWAY_WIN
}

enum AIInsightStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}


model User {
  id String @id @default(uuid())
  email String @unique
  password String 
  name String
  role UserRole @default(USER)
  refreshTokens RefreshToken[]
  predictions Prediction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([email]) //index on email for faster lookups
}

model RefreshToken{
  id String @id @default(uuid())
  token String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([token])
  @@index([userId])
}

model Sport{
  id String @id @default(uuid())
  name String @unique
  type SportType @unique
  leagues League[]
}

model League{
  id String @id @default(uuid())
  name String
  country String
  sportId String
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  teams TeamLeague[]
  matches Match[]
  @@unique([name, sportId])
  @@index([sportId])
}

model Team{
  id String @id @default(uuid())
  name String
  sportId String
  homeMatches Match[]      @relation("HomeTeam")
  awayMatches Match[]      @relation("AwayTeam")
  leagues TeamLeague[]
  @@unique([name, sportId])
  @@index([sportId])
}

model TeamLeague{
  teamId String
  leagueId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade) 
  @@id([teamId, leagueId])
}

model Match{
  id String @id @default(uuid())
  status MatchStatus @default(SCHEDULED)
  homeScore Int @default(0)
  awayScore Int @default(0)
  liveOddsHome Float @default(1.0)
  liveOddsDraw Float @default(1.0)
  liveOddsAway Float @default(1.0)
  matchTime DateTime
  homeTeamId String
  awayTeamId String
  homeTeam Team @relation("HomeTeam",fields: [homeTeamId],references: [id], onDelete: Cascade)
  awayTeam Team @relation("AwayTeam",fields: [awayTeamId],references: [id], onDelete: Cascade)
  leagueId String
  league League @relation(fields: [leagueId],references: [id], onDelete: Cascade)
  predictions Prediction[]
  aiInsight AIInsight?
  oddsHistory OddsHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  @@index([status, matchTime]) 

}

model OddsHistory{
  id String @id @default(uuid())
  oddsHome Float
  oddsDraw Float
  oddsAway Float
  matchId String
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  recordedAt DateTime @default(now())
}

model Prediction{
  id String @id @default(uuid())
  predictedOutcome PredictionOutcome
  confidenceScore Float?
  isCorrect Boolean?
  userId String
  matchId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  @@unique([userId, matchId])
}

model AIInsight{
  id String @id @default(uuid())
  rawAnalysisText String
  status AIInsightStatus @default(PENDING)
  failureReason String?
  homeWinProbability Float
  drawProbability Float
  awayWinProbability Float
  matchId String @unique
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
}